(* FB: FB_Queue – HÀNG ĐỢI FIFO 16 PHÔI – CHỈ LƯU TRỮ DỮ LIỆU       *)
(* MỖI PHÔI GỒM X TÂM (MM), Y TÂM (MM), GÓC (RAD), MỐC E (MM)      *)
(* KHÔNG CHẠM PHẦN CHUYỂN ĐỘNG – NGƯỜI DÙNG TỰ VIẾT RIÊNG PHẦN NÀY *)
(* ĐƠN VỊ CHUẨN MM, MM/S, RADIAN – DÙNG CHO GX WORKS2 ST           *)
(* ================================================================ *)
IF NOT B_EN THEN (* KHI MẤT CHO PHÉP THÌ XÓA SẠCH HÀNG ĐỢI *)
    iHead := 0; (* ĐƯA ĐẦU HÀNG VỀ VỊ TRÍ KHỞI ĐẦU *)
    iTail := 0; (* ĐƯA ĐUÔI HÀNG VỀ VỊ TRÍ KHỞI ĐẦU *)
    iCnt := 0; (* XÓA BỘ ĐẾM SỐ PHÔI ĐANG CHỜ *)
    bOk := FALSE; (* HẠ CỜ BÁO THAO TÁC THÀNH CÔNG *)
    bFull := FALSE; (* XÓA CỜ BÁO ĐẦY HÀNG *)
    bEmpty := TRUE; (* DỰNG CỜ BÁO RỖNG HÀNG *)
    rPopX := 0.0; (* XÓA GIÁ TRỊ X ĐÃ BẬT RA TRƯỚC ĐÓ *)
    rPopY := 0.0; (* XÓA GIÁ TRỊ Y ĐÃ BẬT RA TRƯỚC ĐÓ *)
    rPopAng := 0.0; (* XÓA GIÁ TRỊ GÓC ĐÃ BẬT RA TRƯỚC ĐÓ *)
    rPopE0 := 0.0; (* XÓA GIÁ TRỊ MỐC E ĐÃ BẬT RA TRƯỚC ĐÓ *)
    bPrevPush := FALSE; (* LÀM MỚI NHỚ CẠNH CỦA LỆNH ĐẨY *)
    bPrevPop := FALSE; (* LÀM MỚI NHỚ CẠNH CỦA LỆNH LẤY *)
END_IF; (* KẾT THÚC NHÁNH XÓA KHI MẤT CHO PHÉP *)
IF B_EN THEN (* KHI CÓ CHO PHÉP THÌ XỬ LÝ ĐẨY VÀ LẤY *)
    bOk := FALSE; (* MẶC ĐỊNH MỖI VÒNG CHƯA BÁO THÀNH CÔNG *)
    IF bPush AND NOT bPrevPush THEN (* PHÁT HIỆN CẠNH LÊN CỦA LỆNH ĐẨY *)
        IF iCnt < 16 THEN (* KIỂM TRA HÀNG VẪN CÒN CHỖ TRỐNG *)
            qX[iTail] := rPushX; (* CẤT TỌA ĐỘ X VÀO Ô ĐUÔI HIỆN TẠI *)
            qY[iTail] := rPushY; (* CẤT TỌA ĐỘ Y VÀO Ô ĐUÔI HIỆN TẠI *)
            qAng[iTail] := rPushAng; (* CẤT GÓC XOAY VÀO Ô ĐUÔI HIỆN TẠI *)
            qE[iTail] := rPushE0; (* CẤT MỐC E VÀO Ô ĐUÔI HIỆN TẠI *)
            iTail := (iTail + 1) MOD 16; (* QUAY VÒNG ĐUÔI HÀNG QUANH 16 Ô *)
            iCnt := iCnt + 1; (* TĂNG BỘ ĐẾM SỐ PHÔI ĐANG CHỜ *)
            bOk := TRUE; (* BÁO ĐẨY MỘT PHÔI THÀNH CÔNG *)
        END_IF; (* KẾT THÚC NHÁNH KIỂM TRA CÒN CHỖ TRỐNG *)
    END_IF; (* KẾT THÚC NHÁNH XỬ LÝ CẠNH ĐẨY *)
    IF bPop AND NOT bPrevPop THEN (* PHÁT HIỆN CẠNH LÊN CỦA LỆNH LẤY *)
        IF iCnt > 0 THEN (* KIỂM TRA HÀNG ĐANG CÓ PHÔI CHỜ *)
            rPopX := qX[iHead]; (* LẤY TỌA ĐỘ X TỪ Ô ĐẦU HÀNG *)
            rPopY := qY[iHead]; (* LẤY TỌA ĐỘ Y TỪ Ô ĐẦU HÀNG *)
            rPopAng := qAng[iHead]; (* LẤY GÓC XOAY TỪ Ô ĐẦU HÀNG *)
            rPopE0 := qE[iHead]; (* LẤY MỐC E TỪ Ô ĐẦU HÀNG *)
            iHead := (iHead + 1) MOD 16; (* QUAY VÒNG ĐẦU HÀNG QUANH 16 Ô *)
            iCnt := iCnt - 1; (* GIẢM BỘ ĐẾM SỐ PHÔI ĐANG CHỜ *)
            bOk := TRUE; (* BÁO LẤY MỘT PHÔI THÀNH CÔNG *)
        END_IF; (* KẾT THÚC NHÁNH KIỂM TRA CÓ PHÔI CHỜ *)
    END_IF; (* KẾT THÚC NHÁNH XỬ LÝ CẠNH LẤY *)
    bPrevPush := bPush; (* CẬP NHẬT NHỚ CẠNH ĐẨY CHO VÒNG SAU *)
    bPrevPop := bPop; (* CẬP NHẬT NHỚ CẠNH LẤY CHO VÒNG SAU *)
    IF iCnt >= 16 THEN (* SO SÁNH BỘ ĐẾM VỚI SỨC CHỨA TỐI ĐA *)
        bFull := TRUE; (* DỰNG CỜ BÁO HÀNG ĐÃ ĐẦY *)
    END_IF; (* KẾT THÚC NHÁNH DỰNG CỜ ĐẦY *)
    IF iCnt < 16 THEN (* KIỂM TRA HÀNG CHƯA KÍN CHỖ *)
        bFull := FALSE; (* HẠ CỜ BÁO ĐẦY HÀNG *)
    END_IF; (* KẾT THÚC NHÁNH HẠ CỜ ĐẦY *)
    IF iCnt = 0 THEN (* SO SÁNH BỘ ĐẾM VỚI MỐC RỖNG *)
        bEmpty := TRUE; (* DỰNG CỜ BÁO HÀNG ĐANG RỖNG *)
    END_IF; (* KẾT THÚC NHÁNH DỰNG CỜ RỖNG *)
    IF iCnt > 0 THEN (* KIỂM TRA HÀNG ĐANG CÓ PHÔI *)
        bEmpty := FALSE; (* HẠ CỜ BÁO RỖNG HÀNG *)
    END_IF; (* KẾT THÚC NHÁNH HẠ CỜ RỖNG *)
END_IF; (* KẾT THÚC NHÁNH XỬ LÝ KHI CÓ CHO PHÉP *)

